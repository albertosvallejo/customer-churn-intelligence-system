# Reproducible public release baseline
# Public read-only demo does NOT require an API key.
# Only operator-side LLM flows should switch LLM_MODE=live and set OPENAI_API_KEY in .env.

# Runtime / environment
APP_ENV=local
LOG_LEVEL=INFO
CHURN_API_HOST=0.0.0.0
CHURN_API_PORT=62881

# Data / demo mode
MODE=synthetic_demo
# Synthetic demo works from the bundled data/synthetic_demo namespace.
# Keep these three overrides commented out unless you are explicitly wiring a private local dataset.
# (Do not leave them as empty assignments: docker compose would pass an empty string
# to the container, which overrides the built-in defaults instead of falling back to them.)
# SOURCE_DB_URL=
# CHURN_DB_URL=
# RETENTION_ACTIONS_PARQUET_PATH=
MAX_PARQUET_AGE_HOURS=48
CONVERSION_WINDOW_DAYS=14

# BYOK / LLM policy
LLM_MODE=disabled
OPENAI_API_KEY=
# Optional operator-side Phase 7 overrides
PHASE7_LLM_PROVIDER=openai
PHASE7_OPENAI_MODEL=
PHASE7_OPENAI_REASONING_EFFORT=medium
PHASE7_OPENAI_TEMPERATURE=

# Protected operator routes
PHASE7_REVIEW_TOKEN=change-this-local-demo-token

# Optional reproducibility pin
# Leave empty for the public synthetic demo baseline.
CHURN_SCORING_BUNDLE=

# Operational throttling knobs kept for runtime compatibility
SEND_WINDOW_START_BRT=09:00
SEND_WINDOW_END_BRT=20:00
DAILY_CAP_HIGH=600
DAILY_CAP_MEDIUM=1200
DAILY_CAP_LOW=2000

# Optional Postgres block (not required for the public synthetic demo baseline)
POSTGRES_DB=vivamarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
